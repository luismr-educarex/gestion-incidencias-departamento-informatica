function getSheetRows_(n){const sh=getSpreadsheet_().getSheetByName(n);if(!sh)throw new Error(`No existe la hoja ${n}`);const v=sh.getDataRange().getValues();if(v.length<2)return[];const h=v[0].map(String);return v.slice(1).filter(r=>r.some(x=>x!=='')).map(r=>h.reduce((o,k,i)=>(o[k]=r[i],o),{}))}
function getAulaByCode_(c){c=String(c||'').trim().toUpperCase();return getSheetRows_(APP.SHEETS.AULAS).find(r=>String(r.CODIGO).toUpperCase()===c&&String(r.ACTIVA).toUpperCase()!=='NO')||null}
function getActivosByAula_(c){c=String(c||'').trim().toUpperCase();return getSheetRows_(APP.SHEETS.ACTIVOS).filter(r=>String(r.AULA).toUpperCase()===c&&String(r.ACTIVO).toUpperCase()!=='NO').map(r=>({codigo:String(r.CODIGO),aula:String(r.AULA),tipo:String(r.TIPO),nombre:String(r.NOMBRE||r.CODIGO),x:Number(r.X)||0,y:Number(r.Y)||0,w:Number(r.W)||10,h:Number(r.H)||7,rotacion:Number(r.ROTACION)||0,estado:String(r.ESTADO||'OPERATIVO')}))}
function getOpenIncidentsByAula_(c){const closed=new Set(['RESUELTA','CERRADA']);return getSheetRows_(APP.SHEETS.INCIDENCIAS).filter(r=>String(r.AULA).toUpperCase()===String(c).toUpperCase()&&!closed.has(String(r.ESTADO).toUpperCase())).map(r=>({id:String(r.ID),activo:String(r.ACTIVO),categoria:String(r.CATEGORIA),prioridad:String(r.PRIORIDAD),descripcion:String(r.DESCRIPCION),estado:String(r.ESTADO),fecha:formatDateTime_(r.FECHA_ALTA)}))}
function getCategories_(){return getSheetRows_(APP.SHEETS.CATEGORIAS).filter(r=>String(r.ACTIVA).toUpperCase()!=='NO').map(r=>String(r.CATEGORIA)).filter(Boolean)}
function formatDateTime_(v){if(!v)return'';const d=v instanceof Date?v:new Date(v);return isNaN(d.getTime())?String(v):Utilities.formatDate(d,Session.getScriptTimeZone(),'dd/MM/yyyy HH:mm')}