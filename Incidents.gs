function apiCreateIncident(p){const user=requireRole_([GIDI_ROLES.DOCENTE,GIDI_ROLES.GESTOR,GIDI_ROLES.ADMIN]);if(!p||!String(p.aula||'').trim()||!String(p.categoria||'').trim()||!String(p.descripcion||'').trim())throw new Error('Completa aula, categoría y descripción.');const sh=getSpreadsheet_().getSheetByName(APP.SHEETS.INCIDENCIAS),lock=LockService.getScriptLock();lock.waitLock(10000);try{const id=nextIncidentId_(),now=new Date(),email=user.email;sh.appendRow([id,now,p.aula,p.activo||'AULA',p.tipoActivo||'GENERAL',email,p.categoria,p.prioridad||'NORMAL',String(p.descripcion).slice(0,1000),APP.STATUS.NUEVA,'','','','','']);appendHistory_(id,'ALTA','',APP.STATUS.NUEVA,email,p.descripcion);return{ok:true,id,fecha:formatDateTime_(now)}}finally{lock.releaseLock()}}
function nextIncidentId_(){const pr=PropertiesService.getScriptProperties(),y=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy'),k=`INC_SEQ_${y}`,n=Number(pr.getProperty(k)||0)+1;pr.setProperty(k,String(n));return`INC-${y}-${String(n).padStart(6,'0')}`}
function appendHistory_(incidentId,action,fromState,toState,user,notes){getSpreadsheet_().getSheetByName(APP.SHEETS.HISTORIAL).appendRow([new Date(),incidentId,user||'',action,fromState||'',toState||'',notes||''])}