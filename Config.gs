const APP=Object.freeze({NAME:'GIDI · Gestión de Incidencias del Departamento de Informática',VERSION:'0.5.0',DOMAIN:'educarex.es',SHEETS:{AULAS:'AULAS',ACTIVOS:'ACTIVOS',MAPAS:'MAPAS',INCIDENCIAS:'INCIDENCIAS',HISTORIAL:'HISTORIAL',CATEGORIAS:'CATEGORIAS',CONFIG:'CONFIG',USUARIOS:'USUARIOS'},STATUS:{NUEVA:'NUEVA',ASIGNADA:'ASIGNADA',EN_PROCESO:'EN_PROCESO',RESUELTA:'RESUELTA',CERRADA:'CERRADA',FUERA_SERVICIO:'FUERA_SERVICIO'},PRIORITIES:['NORMAL','ALTA','URGENTE']});
function getSpreadsheet_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Falta SPREADSHEET_ID. Ejecuta setupApplication() una vez.');return SpreadsheetApp.openById(id)}
function getWebAppUrl_(){const url=String(ScriptApp.getService().getUrl()||'');return url.replace(/^https:\/\/script\.google\.com\/macros\/s\//,'https://script.google.com/a/'+APP.DOMAIN+'/macros/s/');}
