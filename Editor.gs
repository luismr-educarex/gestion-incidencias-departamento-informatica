function apiEditorBootstrap(c){const user=requireManager_();const aula=getAulaByCode_(c);if(!aula)throw new Error('Aula no encontrada.');return{ok:true,user,aula,assets:getActivosByAula_(c)}}
function apiSaveMapLayout(c,assets){requireManager_();if(!Array.isArray(assets))throw new Error('Mapa inválido.');const aula=String(c||'').trim().toUpperCase(),sh=getSpreadsheet_().getSheetByName(APP.SHEETS.ACTIVOS),v=sh.getDataRange().getValues(),h=v[0].map(String),ix=Object.fromEntries(h.map((x,i)=>[x,i])),by=new Map(assets.map(a=>[String(a.codigo),a]));let changed=0;for(let r=1;r<v.length;r++){if(String(v[r][ix.AULA]).toUpperCase()!==aula)continue;const a=by.get(String(v[r][ix.CODIGO]));if(!a)continue;v[r][ix.X]=clampNumber_(a.x,0,97);v[r][ix.Y]=clampNumber_(a.y,0,97);v[r][ix.W]=clampNumber_(a.w,3,40);v[r][ix.H]=clampNumber_(a.h,3,25);v[r][ix.ROTACION]=clampNumber_(a.rotacion,-180,180);changed++}if(changed)sh.getRange(1,1,v.length,v[0].length).setValues(v);return{ok:true,changed}}
function clampNumber_(v,a,b){const n=Number(v);return Math.max(a,Math.min(b,isFinite(n)?n:a))}