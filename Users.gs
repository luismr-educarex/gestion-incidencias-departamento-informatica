function apiListUsers(){requireAdmin_();return{ok:true,users:getSheetRows_(APP.SHEETS.USUARIOS).map(r=>({email:String(r.EMAIL||''),nombre:String(r.NOMBRE||''),rol:String(r.ROL||''),activo:String(r.ACTIVO||'SI')}))};}
function apiUpsertUser(payload){requireAdmin_();const email=String(payload&&payload.email||'').trim().toLowerCase(),nombre=String(payload&&payload.nombre||'').trim(),rol=String(payload&&payload.rol||'DOCENTE').trim().toUpperCase(),activo=String(payload&&payload.activo||'SI').trim().toUpperCase();if(!email||!email.includes('@'))throw new Error('Correo no válido.');if(!Object.values(GIDI_ROLES).includes(rol))throw new Error('Rol no válido.');const sh=getSpreadsheet_().getSheetByName(APP.SHEETS.USUARIOS),v=sh.getDataRange().getValues();for(let r=1;r<v.length;r++){if(String(v[r][0]).trim().toLowerCase()===email){sh.getRange(r+1,1,1,4).setValues([[email,nombre,rol,activo]]);return{ok:true,updated:true};}}sh.appendRow([email,nombre,rol,activo]);return{ok:true,created:true};}
function apiDisableUser(email){requireAdmin_();const target=String(email||'').trim().toLowerCase(),sh=getSpreadsheet_().getSheetByName(APP.SHEETS.USUARIOS),v=sh.getDataRange().getValues();for(let r=1;r<v.length;r++){if(String(v[r][0]).trim().toLowerCase()===target){sh.getRange(r+1,4).setValue('NO');return{ok:true};}}throw new Error('Usuario no encontrado.');}
